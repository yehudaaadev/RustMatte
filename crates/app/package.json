{
  "name": "cratesapp",
  "version": "1.0.0",
  "description": "RustMatte Desktop Application",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test tests/*.test.ts",
    "license-check": "license-checker-rseidelsohn --production --excludePackages \"cratesapp@1.0.0\" --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0\"",
    "license-check:all": "license-checker-rseidelsohn --excludePackages \"cratesapp@1.0.0\" --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;MPL-2.0;BlueOak-1.0.0;CC-BY-3.0;(MIT AND CC-BY-3.0)\"",
    "tauri": "tauri"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tauri-apps/cli": "2.12.6",
    "license-checker-rseidelsohn": "5.0.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
